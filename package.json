  "license": "MIT",
  "description": "JARVIS Discord Bot - A multi-purpose Discord bot with leveling system, moderation tools, and more",
  "dependencies": {
    "@vitalets/google-translate-api": "^8.0.0",
    "axios": "^1.7.2",
    "connect-mongo": "^5.1.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "depcheck": "^1.4.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fagghino/JARVIS.git"
  },
  "bugs": {
    "url": "https://github.com/Fagghino/JARVIS/issues"
  },
  "homepage": "https://github.com/Fagghino/JARVIS#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
