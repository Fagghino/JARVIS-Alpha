{
  "name": "jarvis_bot",
  "version": "3.4.7",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "deploy": "node deploy-commands.js",
    "build": "npm run deploy",
    "migrate": "node scripts/migrateSheetsToMongo.js",
    "test": "node -e \"console.log('✅ Syntax check passed')\" && node --check index.js",
    "validate": "node -e \"require('./config/config.js'); console.log('✅ Config valido');\""
