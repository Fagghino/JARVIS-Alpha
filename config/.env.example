# ==============================================================================
# JARVIS Discord Bot - Modello Variabili d'Ambiente (.env.example)
# Copia questo file in config/.env ed inserisci le tue credenziali reali.
# ==============================================================================

# Credenziali Bot Discord & OAuth2 Application
DISCORD_TOKEN=tuo_token_bot_qui
DISCORD_CLIENT_ID=tuo_application_id_qui
DISCORD_CLIENT_SECRET=tuo_oauth2_client_secret_qui

# Configurazione Web Dashboard & Autenticazione
# Sviluppo Locale: http://localhost:8080/auth/callback
# Produzione Render: https://tua-app.onrender.com/auth/callback
REDIRECT_URI=http://localhost:8080/auth/callback
SESSION_SECRET=stringa_casuale_segreta_per_sessioni_cookies
ADMIN_ROLE_IDS=id_ruolo_admin_1,id_ruolo_admin_2

# Connessione Database MongoDB Atlas Cloud
MONGODB_URI=mongodb+srv://utente:password@cluster0.xxx.mongodb.net/jarvis_bot?retryWrites=true&w=majority

# Chiavi API opzionali per le traduzioni (Google Translate gratuito usato di fallback se omesse)
# DEEPL_API_KEY=tua_chiave_deepl
# GOOGLE_TRANSLATE_API_KEY=tua_chiave_google_translate
